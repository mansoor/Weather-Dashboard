# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=weather_dashboard
MYSQL_USER=weather
MYSQL_PASSWORD=weatherpass

# Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Weather Location (default: London)
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278
WEATHER_LOCATION_NAME=London

# Alert Thresholds
ALERT_TEMP_HIGH=35
ALERT_TEMP_LOW=0
ALERT_WIND_HIGH=50
ALERT_AQI_HIGH=3

# Email Notifications (optional — leave blank to use log driver)
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@weather.local
ALERT_EMAIL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
