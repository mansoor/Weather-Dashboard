APP_NAME="Weather Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=weather_dashboard
DB_USERNAME=weather
DB_PASSWORD=weatherpass

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_AQI_BASE_URL=https://air-quality-api.open-meteo.com/v1

WEATHER_LAT=51.5074
WEATHER_LON=-0.1278
WEATHER_LOCATION_NAME=London

ALERT_TEMP_HIGH=35
ALERT_TEMP_LOW=0
ALERT_WIND_HIGH=50
ALERT_AQI_HIGH=3

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@weather.local
ALERT_EMAIL=
